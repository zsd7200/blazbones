<button disabled=@locked style="background-color: @backgroundColor" class="die border border-10 d-flex user-select-none" @onclick="HandleClick">
    <img 
        src="media/img/@(dark ? "dark" : "light")/@(value).png" 
        alt="Die with a value of @value"
        class="img-fluid pe-none"
    />
</button>

@code {
    private Random rng = new Random();
    private record ColorScheme(string Default, string Selected, string Locked);
    public int value { get; set; } = 1; 
    public bool selected { get; set; } = false;
    public bool locked { get; set; } = false;
    public bool dark { get; set; } = true;
    private string backgroundColor { get; set; } = "black";
    private Dictionary<string, ColorScheme> colors { get; } = new Dictionary<string, ColorScheme>() {
        [key: "dark"] = new ColorScheme(Default: "#343A40", Selected: "#0D6EFD", Locked: "#031633"),
        [key: "light"] = new ColorScheme(Default: "#F8F9FA", Selected: "#198754", Locked: "#051B11"),
    };
    
    [Parameter]
    public int index { get; set; } = -1;
    [Parameter]
    public EventCallback OnClickCallback { get; set; }

    private int GetRandomDieValue() {
        return rng.Next(minValue: 1, maxValue: 7);
    }

    private void SetRandomDieValue() {
        value = GetRandomDieValue();
        StateHasChanged();
    }

    private async void HandleClick() {
        if (locked)
            return;

        selected = !selected;
        ChangeColor();
        await OnClickCallback.InvokeAsync();
    }

    public void ChangeColor() {
        backgroundColor = (locked)
            ? (dark) ? colors[key: "dark"].Locked : colors[key: "light"].Locked
            : (selected) 
                ? (dark) ? colors[key: "dark"].Selected : colors[key: "light"].Selected
                : (dark) ? colors[key: "dark"].Default : colors[key: "light"].Default;
        StateHasChanged();
    }

    public void Roll() {
        if (locked)
            return;

        SetRandomDieValue();
    }

    protected override void OnInitialized() {
        base.OnInitialized();
        SetRandomDieValue();
        ChangeColor();
    }
}
