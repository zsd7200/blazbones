@rendermode InteractiveServer

<div class="d-flex">
    <div class="container pt-5 pb-5">
        <div class="row mb-5">
            <div class="col d-flex justify-content-center">
                <Die @ref="die0" index=0 OnClickCallback="@DieClickHandler" />
            </div>
            <div class="col d-flex justify-content-center">
                <Die @ref="die1" index=1 OnClickCallback="@DieClickHandler" />
            </div>
            <div class="col d-flex justify-content-center">
                <Die @ref="die2" index=2 OnClickCallback="@DieClickHandler" />
            </div>
        </div>
        <div class="row">
            <div class="col d-flex justify-content-center">
                <Die @ref="die3" index=3 OnClickCallback="@DieClickHandler" />
            </div>
            <div class="col d-flex justify-content-center">
                <Die @ref="die4" index=4 OnClickCallback="@DieClickHandler" />
            </div>
            <div class="col d-flex justify-content-center">
                <Die @ref="die5" index=5 OnClickCallback="@DieClickHandler" />
            </div>
        </div>
    </div>
    <div class="d-flex w-20">
        <Scoreboard></Scoreboard>
    </div>
</div>
<div>
    <span>Score: @potentialScore</span>
    <div>
        <button class="btn btn-secondary" @onclick="RollHandler">Roll</button>
        <button class="btn btn-secondary" @onclick="EndHandler">End Turn</button>
    </div>
</div>
<Logic />

@code {
    private Die? die0;
    private Die? die1;
    private Die? die2;
    private Die? die3;
    private Die? die4;
    private Die? die5;

    private Die[] dice { get; set; } = new Die[6];
    private int potentialScore { get; set; } = 0;
    private int realScore { get; set; } = 0;

    private List<int[]> rolls = new List<int[]>();
    private Logic logic = new Logic();

    private void RerollAll() {
        for (int i = 0; i < dice.Length; i++) {
            dice[i].locked = false;
            dice[i].selected = false;
            dice[i].ChangeColor();
            dice[i].Roll();
        }
    }

    private void DieClickHandler() {
        int[] diceCount = { 0, 0, 0, 0, 0, 0 };
        int selectedCount = 0;
        int score = 0;

        for (int i = 0; i < dice.Length; i++) {
            if (!dice[i].selected) {
                continue;
            }

            diceCount[dice[i].value - 1]++;
            selectedCount++;
        }

        if (selectedCount == 0) {
            potentialScore = 0;
            return;
        }

        score = logic.ScoreCalc(diceCount);
        potentialScore = (score < 0) ? score : (realScore + score);
    }

    private void RollHandler() {
        int[] diceCount = { 0, 0, 0, 0, 0, 0 };
        int selectedCount = 0;
        int lockedCount = 0;

        for (int i = 0; i < dice.Length; i++) {
            if (dice[i].locked) {
                lockedCount++;
                continue;
            }

            if (dice[i].selected) {
                selectedCount++;
                diceCount[dice[i].value - 1]++;
                continue;
            }
        }

        if (selectedCount == 0) {
            // TODO: error handling
            return;
        }

        if (!logic.ValidateSelection(diceCount)) {
            // TODO: error handling
            return;
        }

        rolls.Add(diceCount);
        realScore = potentialScore;

        if (lockedCount + selectedCount == dice.Length) {
            RerollAll();
            return;
        }

        for (int i = 0; i < dice.Length; i++) {
            if (dice[i].selected) {
                dice[i].locked = true;
                dice[i].selected = false;
                dice[i].ChangeColor();
            }

            if (!dice[i].locked && !dice[i].selected) {
                dice[i].Roll();
            }
        }
    }

    private void EndHandler() {
        potentialScore = 0;
        realScore = 0;
        rolls = new List<int[]>();
        RerollAll();
    }

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            dice = [die0!, die1!, die2!, die3!, die4!, die5!];
        }
    }
}