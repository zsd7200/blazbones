@inject IJSRuntime JS
@inject PlayerSingleton PlayerSingleton

<div class="d-flex flex-wrap">
    <div class="mb-4 w-70">
        <div class="container pt-5 pb-5">
            <div class="row mb-5">
                <div class="col d-flex justify-content-center">
                    <Die @ref="die0" OnClickCallback="@DieClickHandler" />
                </div>
                <div class="col d-flex justify-content-center">
                    <Die @ref="die1" OnClickCallback="@DieClickHandler" />
                </div>
                <div class="col d-flex justify-content-center">
                    <Die @ref="die2" OnClickCallback="@DieClickHandler" />
                </div>
            </div>
            <div class="row">
                <div class="col d-flex justify-content-center">
                    <Die @ref="die3" OnClickCallback="@DieClickHandler" />
                </div>
                <div class="col d-flex justify-content-center">
                    <Die @ref="die4" OnClickCallback="@DieClickHandler" />
                </div>
                <div class="col d-flex justify-content-center">
                    <Die @ref="die5" OnClickCallback="@DieClickHandler" />
                </div>
            </div>
        </div>
        <div>
            <span>Score: @potentialScore</span>
            <div class="d-flex gap-2 align-items-center">
                <div>
                    <button class="btn btn-secondary" @onclick="RollHandler">Roll</button>
                    <button disabled=@endTurnDisabled class="btn btn-secondary" @onclick="EndHandler">End Turn</button>
                    <!-- <button class="btn btn-secondary" @onclick="StraightHandler">End Turn + Roll Straight</button> -->
                </div>
                <div class="@(displayMessage ? "" : "d-none")">
                    <span><strong class="@messageTypeClasses">@messageType: </strong>@message</span>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex w-20">
        <Scoreboard currPlayer=@currPlayer rollCount=@rollCount />
    </div>
</div>

<Logic />

@code {
    private int currPlayer { get; set; } = 0;
    private int rollCount { get; set; } = 1;

    private Die? die0;
    private Die? die1;
    private Die? die2;
    private Die? die3;
    private Die? die4;
    private Die? die5;

    private Die[] dice { get; set; } = new Die[6];
    private int potentialScore { get; set; } = 0;
    private int realScore { get; set; } = 0;
    private Logic logic { get; } = new Logic();
    private String messageType { get; set; } = "";
    private String messageTypeClasses { get; set; } = "";
    private String message { get; set; } = "";
    private bool displayMessage { get; set; } = false;
    private int displayMessageTiming { get; set; } = 5000;

    // delay to prevent people spamming the button and causing opponents to needlessly lose points
    private bool endTurnDisabled { get; set; } = false;
    private int endTurnDisabledTiming { get; } = 1000;

    private async void ShowMessage(string type, string msg) {
        messageType = type;
        message = msg;

        switch (messageType.ToLower()) {
            default:
                messageTypeClasses = "text-primary";
                break;
            case "notice":
                messageTypeClasses = "text-primary-emphasis";
                break;
            case "warning":
                messageTypeClasses = "text-warning";
                break;
            case "error":
                messageTypeClasses = "text-danger";
                break;
            case "congratulations":
            case "success":
                messageTypeClasses = "text-success";
                break;
        }
        displayMessage = true;
        StateHasChanged();
        await Task.Delay(displayMessageTiming);
        HideMessage();
    }

    private void HideMessage() {
        displayMessage = false;
        StateHasChanged();
    }

    private void RerollAll() {
        HideMessage();
        JS.InvokeVoidAsync("playAudio", "media/audio/roll6.wav");
        for (int i = 0; i < dice.Length; i++) {
            dice[i].locked = false;
            dice[i].selected = false;
            dice[i].ChangeColor();
            dice[i].Roll();
        }
    }

    private void DieClickHandler() {
        int[] diceCount = { 0, 0, 0, 0, 0, 0 };
        int[] totalCount = { 0, 0, 0, 0, 0, 0 };
        int selectedCount = 0;
        int score = 0;

        for (int i = 0; i < dice.Length; i++) {
            totalCount[dice[i].value - 1]++;

            if (!dice[i].selected) {
                continue;
            }

            diceCount[dice[i].value - 1]++;
            selectedCount++;
        }

        score = logic.ScoreCalc(diceCount, totalCount);
        potentialScore = (score < 0) ? score : (realScore + score);
    }

    private void RollHandler() {
        int[] diceCount = { 0, 0, 0, 0, 0, 0 };
        int[] totalCount = { 0, 0, 0, 0, 0, 0 };
        int selectedCount = 0;
        int lockedCount = 0;
        int unselectedCount = 6;

        for (int i = 0; i < dice.Length; i++) {
            if (dice[i].locked) {
                lockedCount++;
                continue;
            }

            // ignore locked when counting total
            totalCount[dice[i].value - 1]++;

            if (dice[i].selected) {
                selectedCount++;
                diceCount[dice[i].value - 1]++;
                continue;
            }
        }

        if (selectedCount == 0) {
            ShowMessage("Warning", "No dice selected!");
            return;
        }

        if (!logic.ValidateSelection(diceCount, totalCount)) {
            ShowMessage("Error", "Invalid selection!");
            return;
        }

        HideMessage();
        realScore = potentialScore;

        if (lockedCount + selectedCount == dice.Length) {
            RerollAll();
            return;
        }

        unselectedCount -= (lockedCount + selectedCount);
        JS.InvokeVoidAsync("playAudio", "media/audio/roll" + unselectedCount + ".wav");

        for (int i = 0; i < dice.Length; i++) {
            if (dice[i].selected) {
                dice[i].locked = true;
                dice[i].selected = false;
                dice[i].ChangeColor();
            }

            if (!dice[i].locked && !dice[i].selected) {
                dice[i].Roll();
            }
        }
    }

    private async void EndHandler() {
        DieClickHandler(); // final score gen, needs to happen to go down

        switch(PlayerSingleton.players[PlayerSingleton.players.ElementAt(currPlayer).Key]) {
            default:
                PlayerSingleton.players[PlayerSingleton.players.ElementAt(currPlayer).Key] += potentialScore;
                break;
            case 0:
                if (potentialScore >= 1000) {
                    PlayerSingleton.players[PlayerSingleton.players.ElementAt(currPlayer).Key] += potentialScore;
                }
                break;
            case 1000:
            case 1050:
                if (potentialScore < 0) {
                    PlayerSingleton.players[PlayerSingleton.players.ElementAt(currPlayer).Key] = 0;
                    break;
                }
                PlayerSingleton.players[PlayerSingleton.players.ElementAt(currPlayer).Key] += potentialScore;
                break;
        }

        endTurnDisabled = true;
        potentialScore = 0;
        realScore = 0;
        currPlayer = (PlayerSingleton.players.Count == currPlayer + 1)
            ? 0
            : currPlayer + 1;
        rollCount = (currPlayer == 0)
            ? rollCount + 1
            : rollCount;
        RerollAll();
        await Task.Delay(endTurnDisabledTiming);
        endTurnDisabled = false;
    }

    private void StraightHandler() {
        ShowMessage("Notice", "You rolled a straight! You must end your turn.");
        potentialScore = 0;
        realScore = 0;
        for (int i = 0; i < dice.Length; i++) {
            dice[i].selected = false;
            dice[i].locked = false;
            dice[i].ChangeColor();
            dice[i].value = i + 1;
        }
    }

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            dice = [die0!, die1!, die2!, die3!, die4!, die5!];
        }
    }
}