@inject PlayerSingleton PlayerSingleton

<table class="table table-striped table-hover">
    <thead>
        <th>Player</th>
        <th>Score</th>
    </thead>
    <tbody>
        @foreach (KeyValuePair<string, int> player in PlayerSingleton.players) {
            <tr>
                <td class="@(PlayerSingleton.players.ElementAt(currPlayer).Key == player.Key ? "fw-bold text-primary" : "")">@player.Key</td>
                <td>@player.Value</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter]
    public int currPlayer { get; set; }
}
