@inject PlayerSingleton PlayerSingleton

<div class="d-flex w-100 flex-column gap-2">
    <table class="flex-fill table table-striped table-hover">
        <thead>
            <th>Player</th>
            <th>Score</th>
        </thead>
        <tbody>
            @foreach (KeyValuePair<string, int> player in PlayerSingleton.players) {
                <tr>
                    <td class="@(PlayerSingleton.players.ElementAt(currPlayer).Key == player.Key ? "fw-bold text-primary" : "")">@player.Key</td>
                    <td>@player.Value</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="align-self-end mb-4">
        <span>Roll: @rollCount</span>
    </div>
</div>

@code {
    [Parameter]
    public int currPlayer { get; set; }
    [Parameter]
    public int rollCount { get; set; }
}
