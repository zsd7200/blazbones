@page "/local"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject PlayerSingleton PlayerSingleton

<PageTitle>Local Game | Bones</PageTitle>

<h1 class="text-center">Local Game</h1>

<div class="d-flex justify-content-center">
    <div class="form-group w-10 min-w-3xs">
        <label for="player-count-ctrl">Number of Players</label>
        <select class="form-control" id="player-count-ctrl" @onchange="UpdatePlayerCountHandler">
            <option selected=@(playerCount == 1) value="1">1</option>
            <option selected=@(playerCount == 2) value="2">2</option>
            <option selected=@(playerCount == 3) value="3">3</option>
            <option selected=@(playerCount == 4) value="4">4</option>
            <option selected=@(playerCount == 5) value="5">5</option>
            <option selected=@(playerCount == 6) value="6">6</option>
        </select>
    </div>
</div>

<div class="d-flex justify-content-center">
    <hr class="w-20" />
</div>

<div class="d-flex justify-content-center flex-wrap">
    @for (int i = 0; i < playerCount; i++) {
        int localVar = i;
        <div class="input-group mb-3 mr-2 ml-2 w-30 min-w-xs">
            <span class="input-group-text" id="player-@i-nickname">Player @(i + 1)</span>
            <input 
                @bind="playerNames[localVar]"
                type="text" 
                class="form-control" 
                placeholder="Nickname" 
                aria-label="Nickname" 
                aria-describedby="player-@i-nickname"
            />
        </div>
    }
</div>

<div class="d-flex justify-content-center">
    <button class="btn btn-primary" @onclick="StartGameHandler">Start Game</button>
</div>

@code {
    public Dictionary<string, int> players { get; set; } = new Dictionary<string, int>();
    private int playerCount = 1;
    private string[] playerNames = new string[6];

    private void UpdatePlayerCountHandler(ChangeEventArgs e) {
        playerCount = int.Parse((string)e.Value);
        StateHasChanged();
    }

    private void StartGameHandler() {
        for (int i = 0; i < playerCount; i++) {
            if (string.IsNullOrEmpty(playerNames[i])) {
                playerCount = i;
                break;
            }
            players.Add(playerNames[i], 0);
        }

        PlayerSingleton.players = players;
        Navigation.NavigateTo("/local/game");
    }
}